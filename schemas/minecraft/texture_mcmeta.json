    "width": {
     "type": "integer",
     "description": "Frame width.",
     "markdownDescription": "Frame width."
    },
    "height": {
     "type": "integer",
     "description": "Frame height.",
     "markdownDescription": "Frame height."
    },
    "frametime": {
     "type": "integer",
     "minimum": 1,
     "description": "Ticks per frame (default 1).",
     "markdownDescription": "Ticks per frame (default 1)."
    },
    "frames": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "type": "object",
        "properties": {
         "index": {
          "type": "integer",
          "description": "Frame index.",
          "markdownDescription": "Frame index."
         },
         "time": {
          "type": "integer",
          "description": "Ticks.",
          "markdownDescription": "Ticks."
         }
        },
        "required": [
         "index"
        ]
       }
      ]
     },
     "description": "Frame order.",
     "markdownDescription": "Frame order."
    }
   },
   "defaultSnippets": [
    {
     "body": {
      "frametime": "^${1:2}"
     }
    }
   ],
   "description": "Animated texture (frames stacked vertically).",
   "markdownDescription": "Animated texture (frames stacked vertically)."
  },
  "villager": {
   "type": "object",
   "properties": {
    "hat": {
     "enum": [
      "none",
      "partial",
      "full"
     ],
     "description": "Hat type.",
     "markdownDescription": "Hat type."
    }
   }
  },
  "gui": {
   "type": "object",
   "properties": {
    "scaling": {
     "type": "object",
     "properties": {
      "type": {
       "enum": [
        "stretch",
        "tile",
        "nine_slice"
       ],
       "description": "Scaling.",
       "markdownDescription": "Scaling."
      },
      "width": {
       "type": "integer",
       "description": "Width.",
       "markdownDescription": "Width."
      },
      "height": {
       "type": "integer",
       "description": "Height.",
       "markdownDescription": "Height."
      },
      "border": {
       "type": [
        "integer",
        "object"
       ],
       "description": "Border: int or {left, top, right, bottom}.",
       "markdownDescription": "Border: int or `{left, top, right, bottom}`."
      },
      "stretch_inner": {
       "type": "boolean",
       "description": "Stretch inner.",
       "markdownDescription": "Stretch inner."
      }
     },
     "required": [
      "type"
     ]
