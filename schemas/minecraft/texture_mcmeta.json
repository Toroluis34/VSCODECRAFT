  "texture": {
   "type": "object",
   "properties": {
    "blur": {
     "type": "boolean",
     "description": "Blur.",
     "markdownDescription": "Blur."
    },
    "clamp": {
     "type": "boolean",
     "description": "Clamp.",
     "markdownDescription": "Clamp."
    },
    "mipmap_strategy": {
     "type": "string",
     "description": "Mipmap strategy (1.21.9+).",
     "markdownDescription": "Mipmap strategy (1.21.9+)."
    },
    "alpha_cutoff_bias": {
     "type": "number",
     "description": "Alpha cutoff bias.",
     "markdownDescription": "Alpha cutoff bias."
    }
   }
  }
 }
}
