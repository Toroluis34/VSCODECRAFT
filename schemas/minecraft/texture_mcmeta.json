{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$comment": "Generated by src/features/schemas/tools/build-schemas.mjs — edit the generator, not this file.",
 "title": "Minecraft texture metadata (.png.mcmeta)",
 "type": "object",
 "properties": {
  "animation": {
