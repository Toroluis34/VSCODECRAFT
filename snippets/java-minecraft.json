  "Fabric: network payload (1.21.x)": {
    "prefix": [
      "fabric-payload"
    ],
    "description": "CustomPacketPayload + StreamCodec, registered with PayloadTypeRegistry.playS2C() (Fabric API 1.21.x, Mojang mappings). Identifier = 1.21.11+, ResourceLocation = 1.21–1.21.10.",
    "body": [
      "public record ${1:SyncDataPayload}(${2:int value}) implements CustomPacketPayload {",
      "\tpublic static final CustomPacketPayload.Type<${1}> TYPE = new CustomPacketPayload.Type<>(${9|Identifier,ResourceLocation|}.fromNamespaceAndPath(${3:MyMod}.MOD_ID, \"${4:sync_data}\"));",
      "\tpublic static final StreamCodec<RegistryFriendlyByteBuf, ${1}> STREAM_CODEC = StreamCodec.composite(",
      "\t\t\t${5:ByteBufCodecs.VAR_INT}, ${1}::${6:value},",
      "\t\t\t${1}::new);",
      "",
      "\t@Override",
      "\tpublic CustomPacketPayload.Type<? extends CustomPacketPayload> type() {",
      "\t\treturn TYPE;",
      "\t}",
      "}",
      "",
      "// In onInitialize():  PayloadTypeRegistry.playS2C().register(${1}.TYPE, ${1}.STREAM_CODEC);",
      "// Send (server):       ServerPlayNetworking.send(player, new ${1}(...));",
      "// Receive (client):    ClientPlayNetworking.registerGlobalReceiver(${1}.TYPE, (payload, context) -> { ... });"
    ]
  },
