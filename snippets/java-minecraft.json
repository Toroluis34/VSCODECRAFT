  "Fabric: block + block item (1.21.2+ / 26.x)": {
    "prefix": [
      "fabric-block",
      "fabric-blocks"
    ],
    "description": "ModBlocks with a register helper that also registers the BlockItem. 1.21.2+: setId() on both properties; useBlockDescriptionPrefix() makes the item use the block's translation key.",
    "body": [
      "import java.util.function.Function;",
      "import net.minecraft.core.Registry;",
      "import net.minecraft.core.registries.BuiltInRegistries;",
      "import net.minecraft.core.registries.Registries;",
      "import net.minecraft.resources.ResourceKey;",
      "import net.minecraft.world.item.BlockItem;",
      "import net.minecraft.world.item.Item;",
      "import net.minecraft.world.level.block.Block;",
      "import net.minecraft.world.level.block.SoundType;",
      "import net.minecraft.world.level.block.state.BlockBehaviour;",
      "",
      "public final class ${1:ModBlocks} {",
      "\tpublic static final Block ${2:RUBY_BLOCK} = register(\"${3:ruby_block}\", Block::new,",
      "\t\t\tBlockBehaviour.Properties.of().strength(${4:5.0f}).sound(SoundType.${5:METAL}).requiresCorrectToolForDrops(), true);",
      "",
      "\tprivate static Block register(String name, Function<BlockBehaviour.Properties, Block> factory, BlockBehaviour.Properties properties, boolean withItem) {",
      "\t\tResourceKey<Block> key = ResourceKey.create(Registries.BLOCK, ${6:MyMod}.id(name));",
      "\t\tBlock block = factory.apply(properties.setId(key));",
      "\t\tif (withItem) {",
      "\t\t\tResourceKey<Item> itemKey = ResourceKey.create(Registries.ITEM, ${6}.id(name));",
      "\t\t\tBlockItem item = new BlockItem(block, new Item.Properties().setId(itemKey).useBlockDescriptionPrefix());",
      "\t\t\tRegistry.register(BuiltInRegistries.ITEM, itemKey, item);",
      "\t\t}",
      "\t\treturn Registry.register(BuiltInRegistries.BLOCK, key, block);",
      "\t}",
      "",
      "\tpublic static void init() {}",
      "}"
    ]
  },
  "Fabric: block + block item (1.21 – 1.21.1)": {
    "prefix": [
      "fabric-block-1.21.1"
    ],
    "description": "ModBlocks for 1.21/1.21.1 (no setId).",
    "body": [
      "import net.minecraft.core.Registry;",
      "import net.minecraft.core.registries.BuiltInRegistries;",
      "import net.minecraft.resources.ResourceLocation;",
      "import net.minecraft.world.item.BlockItem;",
      "import net.minecraft.world.item.Item;",
      "import net.minecraft.world.level.block.Block;",
      "import net.minecraft.world.level.block.state.BlockBehaviour;",
      "",
      "public final class ${1:ModBlocks} {",
      "\tpublic static final Block ${2:RUBY_BLOCK} = register(\"${3:ruby_block}\", new Block(BlockBehaviour.Properties.of().strength(${4:5.0f}).requiresCorrectToolForDrops()));",
      "",
      "\tprivate static Block register(String name, Block block) {",
      "\t\tResourceLocation id = ResourceLocation.fromNamespaceAndPath(${5:MyMod}.MOD_ID, name);",
      "\t\tRegistry.register(BuiltInRegistries.ITEM, id, new BlockItem(block, new Item.Properties()));",
      "\t\treturn Registry.register(BuiltInRegistries.BLOCK, id, block);",
      "\t}",
      "",
      "\tpublic static void init() {}",
      "}"
    ]
  },
