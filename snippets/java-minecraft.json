  "Fabric: items class with register helper (1.21.2+ / 26.x)": {
    "prefix": [
      "fabric-items",
      "fabric-item-register"
    ],
    "description": "ModItems with a register helper. Since 1.21.2 Item.Properties must get the item's ResourceKey via setId() BEFORE the item is constructed.",
    "body": [
      "import java.util.function.Function;",
      "import net.minecraft.core.Registry;",
      "import net.minecraft.core.registries.BuiltInRegistries;",
      "import net.minecraft.core.registries.Registries;",
      "import net.minecraft.resources.ResourceKey;",
      "import net.minecraft.world.item.Item;",
      "",
      "public final class ${1:ModItems} {",
      "\tpublic static final Item ${2:RUBY} = register(\"${3:ruby}\", Item::new, new Item.Properties()$4);",
      "",
      "\tpublic static Item register(String name, Function<Item.Properties, Item> factory, Item.Properties properties) {",
      "\t\tResourceKey<Item> key = ResourceKey.create(Registries.ITEM, ${5:MyMod}.id(name));",
      "\t\t// 1.21.2+: the id must be set on the properties before constructing the item",
      "\t\tItem item = factory.apply(properties.setId(key));",
      "\t\treturn Registry.register(BuiltInRegistries.ITEM, key, item);",
      "\t}",
      "",
      "\tpublic static void init() {",
      "\t\t// Called from onInitialize() to load this class",
      "\t}",
      "}"
    ]
  },
